PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017

MAX_UPLOAD_FILES=10
MAX_UPLOAD_FILE_SIZE_MB=5
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png

# object storage
OBS_ENDPOINT=your-liara-s3-endpoint
OBS_ACCESS_KEY=your-access-key
OBS_SECRET_KEY=your-secret-key
OBS_BUCKET_NAME=your-bucket-name
OBS_REGION=us-east-1
